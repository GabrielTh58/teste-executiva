generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VIEWER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum HistoryAction {
  CREATE
  UPDATE_FIELD
  STATUS_CHANGE
}

model Tenant {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  templates Template[]
  contracts Contract[]
  users     User[]

  @@map("tenants")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  role      Role      @default(VIEWER)
  tenantId  String
  createdAt DateTime  @default(now())
  histories History[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([email], map: "idx_user_email")
  @@index([tenantId], map: "idx_user_tenantId")
  @@map("users")
}

model Template {
  id           String     @id @default(uuid())
  name         String
  fieldsConfig Json
  tenantId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isActive     Boolean    @default(false)
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  contracts    Contract[]

  @@index([tenantId], map: "idx_template_tenantId")
  @@map("contract_templates")
}

model Contract {
  id         String         @id @default(uuid())
  name       String
  status     ContractStatus @default(DRAFT)
  content    Json
  tenantId   String
  templateId String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  template   Template       @relation(fields: [templateId], references: [id])
  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  histories  History[]

  @@index([tenantId], map: "idx_contract_tenantId")
  @@index([templateId], map: "idx_contract_templateId")
  @@map("contracts")
}

model History {
  id           String        @id @default(uuid())
  action       HistoryAction
  changedField String?
  oldValue     String?
  newValue     String?
  contractId   String
  changedById  String
  createdAt    DateTime      @default(now())
  changedBy    User          @relation(fields: [changedById], references: [id])
  contract     Contract      @relation(fields: [contractId], references: [id])

  @@index([contractId], map: "idx_history_contractId")
  @@index([changedById], map: "idx_history_changedById")
  @@map("history")
}


