// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VIEWER
}

enum ContractStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum HistoryAction {
  CREATE
  UPDATE_FIELD
  STATUS_CHANGE
}

model Tenant {
  id        String     @id @default(uuid())
  name      String

  users     User[]
  templates Template[]
  contracts Contract[]

  createdAt DateTime   @default(now())

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  histories History[] 

  createdAt DateTime @default(now())

  @@map("users")
  @@index([email], name: "idx_user_email")
  @@index([tenantId], name: "idx_user_tenantId")
}

model Template {
  id               String     @id @default(uuid())
  name             String
  fieldsConfig     Json      
  
  tenantId         String
  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  contracts        Contract[]

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("contract_templates")
  @@index([tenantId], name: "idx_template_tenantId")
}

model Contract {
  id               String         @id @default(uuid())
  status           ContractStatus @default(DRAFT)  
  content          Json           
  
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  templateId       String
  template         Template       @relation(fields: [templateId], references: [id])
  histories        History[]

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("contracts")
  @@index([tenantId], name: "idx_contract_tenantId")
  @@index([templateId], name: "idx_contract_templateId")
}

model History {
  id           String   @id @default(uuid())
  action       HistoryAction
  changedField String?
  oldValue    String?
  newValue    String?
  
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id])
  
  changedById       String
  changedBy         User     @relation(fields: [changedById], references: [id])

  createdAt    DateTime @default(now())

  @@map("history")
  @@index([contractId], name: "idx_history_contractId")
  @@index([changedById], name: "idx_history_changedById")
}